{
  "name": "manychat-contacts",
  "version": "1.0.0",
  "description": "Fetches ManyChat Subscribers information from the API.",
  "keywords": [
    "manychat"
  ],
  "homepage": "https://github.com/weaponsforge/manychat-contacts#readme",
  "bugs": {
    "url": "https://github.com/weaponsforge/manychat-contacts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weaponsforge/manychat-contacts.git"
  },
  "license": "MIT",
  "author": "weaponsforge",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/main.js",
    "subscriber:list": "tsx src/main.ts",
    "docker:debug": "export IS_DOCKER=true && node --inspect=0.0.0.0:9229 ./node_modules/.bin/tsx src/main.ts",
    "transpile": "tsc -p tsconfig.json && tsc-alias",
    "transpile:noemit": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" *.mjs",
    "lint:fix": "eslint \"src/**/*.ts\" *.mjs --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.6",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
